{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    // Extra safety for array and object lookups, but may have false positives.
    "noUncheckedIndexedAccess": true,

    // Enables a wide range of aggressive type checking behavior to ensure code correctness.
    "strict": true,

    // Ensures optional object properties strictly disallow explicit 'undefined' assignments.
    "exactOptionalPropertyTypes": true,

    // Enforces the use of 'import type' and 'export type' for type-only declarations.
    "verbatimModuleSyntax": true,

    // Reports errors on local variables that are declared but never used anywhere.
    "noUnusedLocals": true,

    // Path mapping for cleaner imports.
    "paths": { "@/*": ["./src/*"], "vue": ["./node_modules/vue"], "vue-i18n": ["./node_modules/vue-i18n"] },

    // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
