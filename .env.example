# Copy to .env.local and fill in from the Supabase dashboard, under
# Project Settings → API Keys.
#
# VITE_SUPABASE_ANON_KEY is the only key the app reads. It takes a key with the
# `anon` role — either the legacy `anon` `public` JWT (starts with `eyJ…`, under
# the Legacy API keys tab) or the current publishable key (`sb_publishable_…`).
# The two are the same role and behave identically. Whichever it is, it is
# public by design: it ships inside the bundle, and row-level security is the
# boundary, not the key.
#
# A key is tied to one project. Its `ref` claim must match the URL above, so a
# key borrowed from another project will not work. `pnpm check:env` says so
# before a deploy does.
#
# The `sb_secret_` key (older projects: `service_role`) must never go here. It
# bypasses every policy, and because VITE_ variables are inlined at build time
# it would end up in a file any visitor can read. The build refuses to compile
# one — see the `kakei:refuse-secret-key` plugin in vite.config.ts.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Kept for reference alongside the legacy key, as in Hibi. Nothing reads it.
VITE_SUPABASE_PUBLISHABLE_KEY=

# The public origin, used for absolute og: URLs in index.html. Optional:
# without it the social card falls back to root-relative paths.
VITE_SITE_URL=
