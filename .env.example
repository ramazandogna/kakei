# Copy to .env.local and fill in from the Supabase dashboard:
# Project Settings → API → Project URL and the `anon` `public` key.
#
# Both are public by design. The anon key ships in the bundle; row-level
# security is the boundary, not the key. The service_role key must never
# appear in this file or anywhere else the browser can reach.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The public origin, used for absolute og: URLs in index.html. Optional:
# without it the social card falls back to root-relative paths.
VITE_SITE_URL=
