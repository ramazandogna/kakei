# Copy to .env.local and fill in from the Supabase dashboard, under
# Project Settings → API Keys.
#
# VITE_SUPABASE_ANON_KEY is the only key the app reads. Use the PUBLISHABLE key
# — the one beginning `sb_publishable_`. It is public by design: it ships inside
# the bundle, and row-level security is the boundary, not the key. On its own it
# returns nothing at all.
#
# Do not use the Legacy API keys. There are two of them, both start with `eyJ`,
# and one is `service_role`, which bypasses every policy. Telling them apart by
# eye is a trap that has cost this project two broken deploys. The publishable
# key does the same job with nothing to get wrong.
#
# The build refuses to compile a bundle carrying a key that bypasses RLS, in
# either format — see `kakei:refuse-secret-key` in vite.config.ts. Run
# `pnpm check:env` to check a value before it goes near Vercel.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Kept for reference alongside the legacy key, as in Hibi. Nothing reads it.
VITE_SUPABASE_PUBLISHABLE_KEY=

# The public origin, used for absolute og: URLs in index.html. Optional:
# without it the social card falls back to root-relative paths.
VITE_SITE_URL=
